# CyberSentinel X — local defensive deployment
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_TOKEN=REPLACE_WITH_A_RANDOM_BRIDGE_SECRET
DB_PATH=~/.cybersentinel-x/intel.db

# Enable the browser UI locally. The bridge is hard-bound to 127.0.0.1.
PUBLIC_WEB_ENABLED=true
PUBLIC_SESSION_COOKIE=cs_public_session
PUBLIC_SESSION_TTL_SECONDS=1800
PUBLIC_OWNER_SESSION_COOKIE=cs_owner_session
# Optional exact allowed Origin. When blank, only a same-host Origin is accepted.
# The shipped UI is same-origin; this setting does not enable cross-origin CORS.
PUBLIC_WEB_ORIGIN=

# Optional backward-compatible OpenAI-compatible endpoint.
# Leave blank for the deterministic local planner.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# Owner username/password is bootstrapped interactively and stored as a verifier
# in the local database; it is not configured as an environment token.

# Optional multi-provider OpenAI-compatible endpoints.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_LLM_MODEL=Qwen/Qwen3-Coder-Next
# LOCAL_LLM_API_KEY=
# COLAB_LLM_BASE_URL=https://YOUR-TUNNEL/v1
# COLAB_LLM_MODEL=Qwen/Qwen3-Coder-Next
# COLAB_LLM_API_KEY=
# HF_LLM_BASE_URL=https://YOUR-ENDPOINT/v1
# HF_LLM_MODEL=Qwen/Qwen3-Coder-Next
# HF_LLM_API_KEY=hf_xxx
