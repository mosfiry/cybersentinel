# CyberSentinel X — local defensive deployment
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
DB_PATH=~/.cybersentinel-x/intel.db

# Optional OpenAI-compatible reasoning endpoint.
# Leave blank for deterministic local planner.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# Owner authentication. The word "Owner" is only a marker; this token is the actual credential.
OWNER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_OWNER_SECRET
CYBERSENTINEL_OWNER_PHRASE=Owner

# Optional multi-provider OpenAI-compatible endpoints.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_LLM_MODEL=Qwen/Qwen3-Coder-Next
# LOCAL_LLM_API_KEY=
# COLAB_LLM_BASE_URL=https://YOUR-TUNNEL/v1
# COLAB_LLM_MODEL=Qwen/Qwen3-Coder-Next
# COLAB_LLM_API_KEY=
# HF_LLM_BASE_URL=https://YOUR-ENDPOINT/v1
# HF_LLM_MODEL=Qwen/Qwen3-Coder-Next
# HF_LLM_API_KEY=hf_xxx
