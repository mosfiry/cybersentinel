# CyberSentinel X — host-process development and Docker Compose settings.
# For direct host runs only, keep .env private (chmod 600) and set a random
# BRIDGE_TOKEN of at least 32 characters. Compose does not pass these secret
# values to containers; it mounts files from CYBERSENTINEL_SECRETS_DIR instead.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_TOKEN=REPLACE_WITH_A_RANDOM_BRIDGE_SECRET
DB_PATH=~/.cybersentinel-x/intel.db

# Public Owner UI is disabled by default. The Desktop shell explicitly enables
# it on 127.0.0.1; non-loopback deployments require an exact HTTPS origin.
PUBLIC_WEB_ENABLED=false
PUBLIC_WEB_ORIGIN=
PUBLIC_SESSION_COOKIE=cs_public_session
PUBLIC_OWNER_SESSION_COOKIE=cs_owner_session
PUBLIC_SESSION_TTL_SECONDS=1800

# Compose-only, non-secret settings.
BRIDGE_PUBLISHED_PORT=8787
CYBERSENTINEL_SECRETS_DIR=./secrets
CYBERSENTINEL_OWNER_PHRASE=Owner
CYBERSENTINEL_VERSION=5.2.0-rc1
CYBERSENTINEL_IMAGE=cybersentinel-runtime:5.2.0-rc1
COMPOSE_PROJECT_NAME=cybersentinel

# Optional OpenAI-compatible endpoint settings. These are non-secret values.
# Leave blank for the deterministic local planner.
LLM_BASE_URL=
LLM_MODEL=

# Optional multi-provider endpoints implementing OpenAI-compatible
# /chat/completions. Provider credentials for Compose belong in the matching
# root-protected files under ./secrets; do not put production keys in .env.
# Host-process development only: uncomment a key here if needed; Compose ignores
# these credential values and mounts its own file-backed secrets.
# LLM_API_KEY=
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_MODEL=Qwen/Qwen3-Coder-Next
# COLAB_LLM_BASE_URL=https://YOUR-ENDPOINT/v1
# COLAB_LLM_API_KEY=
# COLAB_LLM_MODEL=Qwen/Qwen3-Coder-Next
# HF_LLM_BASE_URL=https://YOUR-ENDPOINT/v1
# HF_LLM_API_KEY=
# HF_LLM_MODEL=Qwen/Qwen3-Coder-Next

# Optional provider contract metadata. Deployment must be explicitly set to
# local/remote before same-deployment failover is allowed; unknown is fail-closed.
# Capability flags describe what the endpoint actually supports; they are not
# inferred from the model name. Hardware fields are requirements, not detection.
# LOCAL_LLM_DEPLOYMENT=local
# LOCAL_LLM_MODEL_VERSION=3
# LOCAL_LLM_QUANTIZATION=Q4_K_M
# LOCAL_LLM_CONTEXT_LENGTH=4096
# LOCAL_LLM_ACCELERATOR=cpu
# LOCAL_LLM_MIN_RAM_GIB=8
# LOCAL_LLM_MIN_VRAM_GIB=0
# LOCAL_LLM_MIN_CPU_CORES=4
# LOCAL_LLM_REASONING=false
# LOCAL_LLM_REASONING_BUDGET=false
# LOCAL_LLM_PARALLEL_TOOL_CALLS=false
# LOCAL_LLM_LONG_CONTEXT=false
# LOCAL_LLM_VISION=false
# COLAB_LLM_DEPLOYMENT=remote
# COLAB_LLM_MODEL_VERSION=3
# COLAB_LLM_QUANTIZATION=BF16
# COLAB_LLM_CONTEXT_LENGTH=8192
# HF_LLM_DEPLOYMENT=remote
# Cross-deployment fallback (for example local to remote) is disabled by default.
# Enable only when that data-routing change is intentional and approved:
# LLM_ALLOW_CROSS_DEPLOYMENT_FALLBACK=false
