{
  "version": "2.0",
  "require_owner_token": true,
  "owner_phrase": "Owner",
  "evidence_required": true,
  "sandbox_by_default": true,
  "external_targets_require_scope": true,
  "destructive_requires_approval": true,
  "immutable": false,
  "latest_owner_instruction_is_current_policy": true,
  "owner_instruction_precedence": "latest_wins",
  "owner_authority_level": "highest_application_policy",
  "external_content_authority": "none",
  "model_authority": "none",
  "system_safety_boundary": "immutable",
  "runtime_limits": {
    "max_context_messages": 50,
    "max_context_chars": 32000,
    "max_result_chars": 4000,
    "max_tool_calls": 10,
    "max_execution_steps": 20,
    "max_same_tool_calls": 5,
    "max_execution_time_seconds": 300,
    "max_pending_tasks": 10,
    "max_retries": 3,
    "max_total_output_chars": 8000
  }
}
