# BRIDGE_TOKEN is transport authentication and belongs in the untracked .env.
# Owner identity is a username/password account; bootstrap it interactively with
# python -m security.owner_password_bootstrap. The word "Owner" alone is not authentication.
CYBERSENTINEL_OWNER_PHRASE=Owner

# Optional model endpoints. Each must expose POST /chat/completions.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_LLM_MODEL=Qwen/Qwen3-Coder-Next

# COLAB_LLM_BASE_URL=https://YOUR-COLAB-TUNNEL/v1
# COLAB_LLM_MODEL=Qwen/Qwen3-Coder-Next
# COLAB_LLM_API_KEY=

# HF_LLM_BASE_URL=https://YOUR-HF-ENDPOINT/v1
# HF_LLM_MODEL=Qwen/Qwen3-Coder-Next
# HF_LLM_API_KEY=hf_xxx
